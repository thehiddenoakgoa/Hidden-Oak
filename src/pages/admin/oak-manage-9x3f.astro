---
/**
 * Hidden Admin Dashboard — /admin/oak-manage-9x3f
 *
 * NOT linked anywhere, noindex, excluded from sitemap.
 * Password-protected via ADMIN_TOKEN (env). Session-storage bearer.
 * CRM: view/search/filter/update bookings, export CSV, stats.
 *
 * Keep this URL secret. Rotate by renaming the file if needed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin · Bookings" description="Hidden Oak bookings admin" noindex>
  <section class="admin-wrap" id="admin-root">
    <div class="container admin-container">

      {/* Header */}
      <div class="admin-head" data-reveal>
        <div>
          <p class="eyebrow">Hidden Oak — Admin</p>
          <h1>Bookings & CRM</h1>
          <p class="lede">Manage all reservations. Cash on arrival. Notifications go to <strong>thehiddenoak.goa@gmail.com</strong></p>
        </div>
        <div class="admin-head__meta">
          <span id="admin-env-badge" class="admin-badge">Checking auth…</span>
          <button id="admin-logout" class="admin-ghost" hidden>Logout</button>
        </div>
      </div>

      {/* Login */}
      <div class="admin-card admin-login" id="admin-login" data-reveal>
        <h2>Admin access</h2>
        <p class="admin-muted">Enter the admin token set in Cloudflare (<code>ADMIN_TOKEN</code>). This page is not linked anywhere and is <code>noindex</code>.</p>
        <form id="login-form" class="admin-form">
          <label class="field">
            <span class="field__label">Admin token <span style="color: var(--hot-coal-bright)">*</span></span>
            <input type="password" name="token" id="login-token" placeholder="Paste token" autocomplete="current-password" required />
          </label>
          <button type="submit" class="cta cta--primary cta--md" id="login-btn"><span class="cta__shine"></span><span class="cta__label">Enter dashboard</span></button>
          <p class="admin-hint">If no token is configured on the server, any value will work locally (dev mode). Set <code>ADMIN_TOKEN</code> in Cloudflare Pages → Settings → Env vars (Encrypted) for production.</p>
          <div class="admin-status" id="login-status" role="status" aria-live="polite" hidden></div>
        </form>
      </div>

      {/* Dashboard */}
      <div id="admin-dashboard" hidden>
        {/* Stats */}
        <div class="admin-stats" id="admin-stats" data-reveal>
          <!-- injected -->
        </div>

        {/* Controls */}
        <div class="admin-controls" data-reveal>
          <div class="admin-controls__row">
            <label class="admin-search">
              <span aria-hidden="true">⌕</span>
              <input type="search" id="q" placeholder="Search name, email, phone, ID…" autocomplete="off" />
            </label>
            <select id="f-status" aria-label="Filter by status">
              <option value="all">All statuses</option>
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
              <option value="no-show">No-show</option>
            </select>
            <select id="f-service" aria-label="Filter by service">
              <option value="all">All services</option>
              <option value="without_ice">Without Ice Bath</option>
              <option value="contrast_sound">Contrast + Sound</option>
            </select>
            <input type="date" id="f-date" aria-label="Filter by date" />
            <button type="button" id="f-clear" class="admin-ghost">Clear</button>
          </div>
          <div class="admin-controls__row admin-controls__row--actions">
            <span class="admin-count" id="admin-count"></span>
            <div class="admin-actions">
              <button type="button" id="btn-refresh" class="admin-ghost">↻ Refresh</button>
              <button type="button" id="btn-export" class="admin-ghost">⬇ Export CSV</button>
              <button type="button" id="btn-today" class="cta cta--ghost cta--md">Today</button>
            </div>
          </div>
        </div>

        {/* Table */}
        <div class="admin-table-wrap" data-reveal>
          <div class="admin-table-scroller">
            <table class="admin-table" id="bookings-table">
              <thead>
                <tr>
                  <th>Date / Slot</th>
                  <th>Guest</th>
                  <th>Service</th>
                  <th>Guests</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="bookings-tbody">
                <tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--color-ink-subtle);">Loading bookings…</td></tr>
              </tbody>
            </table>
          </div>
          <div class="admin-pagination" id="admin-pagination" hidden>
            <button type="button" id="pg-prev" class="admin-ghost">‹ Prev</button>
            <span id="pg-info" class="admin-muted"></span>
            <button type="button" id="pg-next" class="admin-ghost">Next ›</button>
          </div>
        </div>

        {/* Detail drawer */}
        <dialog class="admin-dialog" id="detail-dialog" aria-label="Booking details">
          <form method="dialog" class="admin-dialog__head">
            <h3>Booking details</h3>
            <button type="submit" class="admin-ghost" aria-label="Close">✕</button>
          </form>
          <div class="admin-dialog__body" id="detail-body"></div>
          <div class="admin-dialog__foot" id="detail-foot"></div>
        </dialog>

        {/* Calendar mini */}
        <div class="admin-cal" data-reveal id="admin-cal-wrap">
          <h3>Upcoming days at a glance</h3>
          <p class="admin-muted">Spots per slot (taken / capacity). Click a date to filter.</p>
          <div class="admin-cal__grid" id="admin-cal"></div>
        </div>

        <p class="admin-footnote">
          Hidden URL: <code>/admin/oak-manage-9x3f</code> · Not in navigation, <code>noindex</code>, excluded from sitemap. Rotate by renaming the file. Auth via <code>ADMIN_TOKEN</code> env (Bearer). Capacity via <code>SLOT_CAPACITY</code> (default 8). Emails via Brevo to <code id="notify-email-display">thehiddenoak.goa@gmail.com</code>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  (() => {
    const $ = (s, r=document) => r.querySelector(s);
    const root = $('#admin-root');
    const loginCard = $('#admin-login');
    const dash = $('#admin-dashboard');
    const loginForm = $('#login-form');
    const loginToken = $('#login-token');
    const loginStatus = $('#login-status');
    const loginBtn = $('#login-btn');
    const badge = $('#admin-env-badge');
    const logoutBtn = $('#admin-logout');
    const tbody = $('#bookings-tbody');
    const statsEl = $('#admin-stats');
    const countEl = $('#admin-count');
    const qEl = $('#q');
    const fStatus = $('#f-status');
    const fService = $('#f-service');
    const fDate = $('#f-date');
    const btnExport = $('#btn-export');
    const btnRefresh = $('#btn-refresh');
    const btnToday = $('#btn-today');
    const btnClear = $('#f-clear');
    const pgPrev = $('#pg-prev');
    const pgNext = $('#pg-next');
    const pgInfo = $('#pg-info');
    const pgWrap = $('#admin-pagination');
    const calGrid = $('#admin-cal');
    const detailDialog = $('#detail-dialog');
    const detailBody = $('#detail-body');
    const detailFoot = $('#detail-foot');

    const TOKEN_KEY = 'oak_admin_token';
    let allBookings = [];
    let filtered = [];
    let stats = null;
    let capacity = 8;
    let page = 1;
    const PAGE_SIZE = 20;
    let debounceTimer = null;

    function getToken() {
      return sessionStorage.getItem(TOKEN_KEY) || '';
    }
    function setToken(t) {
      if (t) sessionStorage.setItem(TOKEN_KEY, t);
      else sessionStorage.removeItem(TOKEN_KEY);
    }
    function setBadge(text, ok) {
      if (!badge) return;
      badge.textContent = text;
      badge.className = 'admin-badge' + (ok ? ' admin-badge--ok' : ' admin-badge--warn');
    }
    function setLoginStatus(msg, ok) {
      if (!loginStatus) return;
      loginStatus.hidden = false;
      loginStatus.textContent = msg;
      loginStatus.className = 'admin-status' + (ok ? ' admin-status--ok' : ' admin-status--err');
    }

    async function tryAutoLogin() {
      const tok = getToken();
      if (!tok) {
        setBadge('Not authenticated', false);
        return false;
      }
      // try fetching with token
      try {
        const res = await fetch('/api/bookings?status=all', {
          headers: { 'Authorization': `Bearer ${tok}` }
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          showDashboard(tok, data);
          return true;
        }
        // maybe dev mode with no token required?
        if (res.status === 401) {
          setBadge('Invalid token — please login again', false);
          setToken('');
          return false;
        }
        // if 200 but no token required locally, treat as success even with empty
        showDashboard(tok, data);
        return true;
      } catch (e) {
        setBadge('Auth check failed', false);
        return false;
      }
    }

    function showLogin() {
      if (loginCard) loginCard.hidden = false;
      if (dash) dash.hidden = true;
      if (logoutBtn) logoutBtn.hidden = true;
    }
    function showDashboard(token, initialData) {
      if (loginCard) loginCard.hidden = true;
      if (dash) dash.hidden = false;
      if (logoutBtn) logoutBtn.hidden = false;
      setBadge('Authenticated ✓', true);
      if (initialData) {
        allBookings = initialData.bookings || [];
        stats = initialData.stats || null;
        capacity = initialData.capacity || 8;
        renderStats();
        applyFilters();
        renderCal();
      } else {
        fetchBookings();
      }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const tok = String(loginToken ? loginToken.value : '').trim();
        if (!tok) { setLoginStatus('Token is required', false); return; }
        const btnLabel = loginBtn ? loginBtn.querySelector('.cta__label') : null;
        const orig = btnLabel ? btnLabel.textContent : '';
        if (btnLabel) btnLabel.textContent = 'Checking…';
        if (loginBtn) loginBtn.disabled = true;
        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: tok })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            setLoginStatus(data.error || 'Invalid token', false);
            if (btnLabel) btnLabel.textContent = orig;
            if (loginBtn) loginBtn.disabled = false;
            return;
          }
          setToken(tok);
          setLoginStatus('Welcome — loading bookings…', true);
          // verify bookings access
          const bRes = await fetch('/api/bookings?status=all', { headers: { 'Authorization': `Bearer ${tok}` }});
          const bData = await bRes.json();
          if (!bRes.ok) throw new Error(bData.error || 'Failed to load bookings');
          showDashboard(tok, bData);
        } catch (err) {
          setLoginStatus('Error: ' + (err.message || String(err)), false);
          if (btnLabel) btnLabel.textContent = orig;
          if (loginBtn) loginBtn.disabled = false;
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        setToken('');
        allBookings = [];
        filtered = [];
        if (qEl) qEl.value = '';
        if (fStatus) fStatus.value = 'all';
        if (fService) fService.value = 'all';
        if (fDate) fDate.value = '';
        showLogin();
        setBadge('Logged out', false);
      });
    }

    async function fetchBookings() {
      const tok = getToken();
      if (!tok) { showLogin(); return; }
      try {
        if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="padding:1.5rem;text-align:center;color:var(--color-ink-subtle);">Loading…</td></tr>`;
        const params = new URLSearchParams();
        // we fetch all and filter client side for speed
        const res = await fetch('/api/bookings?status=all', { headers: { 'Authorization': `Bearer ${tok}` }});
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (res.status === 401) {
            setToken('');
            showLogin();
            setLoginStatus('Session expired — please login again', false);
            return;
          }
          throw new Error(data.error || 'Failed');
        }
        allBookings = data.bookings || [];
        stats = data.stats || null;
        capacity = data.capacity || 8;
        // update notify display if env provided? keep default
        renderStats();
        applyFilters();
        renderCal();
      } catch (err) {
        if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="padding:1.5rem;text-align:center;color:var(--color-danger);">Failed to load: ${err.message || String(err)}</td></tr>`;
      }
    }

    function renderStats() {
      if (!statsEl || !stats) return;
      const today = stats.today || 0;
      const cards = [
        { k: 'Total', v: stats.total || allBookings.length, s: 'all time' },
        { k: 'Pending', v: stats.pending || 0, s: 'needs confirm' },
        { k: 'Confirmed', v: stats.confirmed || 0, s: 'coming' },
        { k: 'Upcoming', v: stats.upcoming || 0, s: 'pending+confirmed ≥ today' },
        { k: 'Est. revenue', v: `₹${(stats.revenue_pending || 0).toLocaleString('en-IN')}`, s: 'pending+confirmed × guests' },
        { k: 'Today', v: today, s: new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }) + ' IST' },
      ];
      statsEl.innerHTML = cards.map(c => `
        <div class="admin-stat">
          <span class="admin-stat__k">${c.k}</span>
          <span class="admin-stat__v">${c.v}</span>
          <span class="admin-stat__s">${c.s}</span>
        </div>
      `).join('');
    }

    function applyFilters() {
      let list = [...allBookings];
      const q = (qEl ? qEl.value : '').trim().toLowerCase();
      const st = fStatus ? fStatus.value : 'all';
      const svc = fService ? fService.value : 'all';
      const dt = fDate ? fDate.value : '';
      if (st !== 'all') list = list.filter(b => b.status === st);
      if (svc !== 'all') list = list.filter(b => b.service === svc);
      if (dt) list = list.filter(b => b.date === dt);
      if (q) {
        list = list.filter(b =>
          (b.name||'').toLowerCase().includes(q) ||
          (b.email||'').toLowerCase().includes(q) ||
          (b.phone||'').toLowerCase().includes(q) ||
          (b.id||'').toLowerCase().includes(q)
        );
      }
      // sort by date desc then slot then created_at
      list.sort((a,b) => {
        if (a.date !== b.date) return b.date.localeCompare(a.date);
        if (a.slot !== b.slot) return a.slot.localeCompare(b.slot);
        return (b.created_at||'').localeCompare(a.created_at||'');
      });
      filtered = list;
      page = 1;
      renderTable();
    }

    function renderTable() {
      if (!tbody || !countEl) return;
      const total = filtered.length;
      countEl.textContent = `${total} booking${total===1?'':'s'}${total !== allBookings.length ? ` (filtered from ${allBookings.length})` : ''}`;
      const start = (page-1)*PAGE_SIZE;
      const slice = filtered.slice(start, start+PAGE_SIZE);
      if (slice.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="padding:2rem;text-align:center;color:var(--color-ink-subtle);">No bookings found. Try clearing filters.</td></tr>`;
      } else {
        tbody.innerHTML = slice.map(b => {
          const statusCls = `st-${b.status.replace(' ','-')}`;
          const created = b.created_at ? new Date(b.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) : '—';
          return `<tr data-id="${b.id}">
            <td><strong style="font-family:var(--font-mono); font-size:0.84rem; color:var(--forest-deep)">${b.date}</strong><br/><span style="font-family:var(--font-mono); font-size:0.78rem; color:var(--hot-coal-bright)">${b.slot}</span><br/><span style="font-size:0.72rem; color:var(--color-ink-subtle)">${b.id}</span></td>
            <td><strong style="color:var(--forest-deep)">${escape(b.name)}</strong><br/><span style="font-size:0.82rem; color:var(--color-ink-muted)">${escape(b.email)}</span><br/><span style="font-size:0.82rem; color:var(--color-ink-subtle)">${escape(b.phone||'—')}</span></td>
            <td><span style="font-size:0.86rem; color:var(--forest-deep)">${escape(b.service_label||b.service)}</span><br/><span style="font-size:0.72rem; color:var(--color-ink-subtle)">${escape(b.price_label||'—')}</span></td>
            <td style="text-align:center; font-weight:700; color:var(--forest-deep)">${b.guests}</td>
            <td><span class="admin-pill ${statusCls}">${escape(b.status)}</span></td>
            <td style="font-size:0.78rem; color:var(--color-ink-subtle)">${created}</td>
            <td>
              <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <button type="button" class="admin-mini" data-action="view" data-id="${b.id}">View</button>
                <select data-action="status" data-id="${b.id}" class="admin-mini-select" aria-label="Change status">
                  <option value="">Set status…</option>
                  <option value="pending">pending</option>
                  <option value="confirmed">confirmed</option>
                  <option value="completed">completed</option>
                  <option value="cancelled">cancelled</option>
                  <option value="no-show">no-show</option>
                </select>
              </div>
            </td>
          </tr>`;
        }).join('');
        // bind view/status
        tbody.querySelectorAll('[data-action="view"]').forEach(btn => {
          btn.addEventListener('click', () => openDetail(btn.getAttribute('data-id')));
        });
        tbody.querySelectorAll('[data-action="status"]').forEach(sel => {
          sel.addEventListener('change', async (e) => {
            const target = e.target;
            const id = target.getAttribute('data-id');
            const val = target.value;
            if (!val) return;
            if (!confirm(`Change ${id} status to "${val}"?`)) { target.value=''; return; }
            await patchBooking(id, { status: val });
            target.value='';
          });
        });
      }
      // pagination
      const pages = Math.ceil(total / PAGE_SIZE) || 1;
      if (pgWrap) pgWrap.hidden = pages <= 1;
      if (pgInfo) pgInfo.textContent = `Page ${page} of ${pages}`;
      if (pgPrev) pgPrev.disabled = page <= 1;
      if (pgNext) pgNext.disabled = page >= pages;
    }

    function escape(s) {
      return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Pagination
    if (pgPrev) pgPrev.addEventListener('click', () => { if (page>1){ page--; renderTable(); }});
    if (pgNext) pgNext.addEventListener('click', () => { const pages=Math.ceil(filtered.length/PAGE_SIZE); if (page<pages){ page++; renderTable(); }});

    // Filters with debounce for search
    function bindFilter(el, immediate) {
      if (!el) return;
      const evt = el.tagName === 'INPUT' && el.type === 'search' ? 'input' : 'change';
      el.addEventListener(evt, () => {
        if (el === qEl) {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(applyFilters, 250);
        } else {
          applyFilters();
        }
      });
    }
    bindFilter(qEl); bindFilter(fStatus, true); bindFilter(fService, true); bindFilter(fDate, true);
    if (btnClear) btnClear.addEventListener('click', () => {
      if (qEl) qEl.value=''; if (fStatus) fStatus.value='all'; if (fService) fService.value='all'; if (fDate) fDate.value=''; applyFilters();
    });
    if (btnRefresh) btnRefresh.addEventListener('click', fetchBookings);
    if (btnToday) btnToday.addEventListener('click', () => {
      const today = new Date().toLocaleDateString('en-CA', { timeZone:'Asia/Kolkata'});
      if (fDate) fDate.value = today;
      applyFilters();
      window.scrollTo({ top: document.querySelector('.admin-table-wrap')?.offsetTop - 20 || 0, behavior: 'smooth'});
    });

    // Export CSV
    if (btnExport) btnExport.addEventListener('click', () => {
      if (filtered.length===0) { alert('No bookings to export'); return; }
      const headers = ['id','created_at','date','slot','service','service_label','guests','name','email','phone','status','notes'];
      const rows = [headers.join(',')];
      filtered.forEach(b => {
        const vals = headers.map(h => {
          let v = b[h] ?? '';
          v = String(v).replace(/"/g,'""');
          if (v.includes(',')||v.includes('"')||v.includes('\n')) v = `"${v}"`;
          return v;
        });
        rows.push(vals.join(','));
      });
      const blob = new Blob([rows.join('\n')], {type:'text/csv;charset=utf-8;'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href=url; a.download=`hidden-oak-bookings-${new Date().toISOString().slice(0,10)}.csv`; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    });

    async function patchBooking(id, patch) {
      const tok = getToken();
      try {
        const res = await fetch(`/api/bookings/${encodeURIComponent(id)}`, {
          method:'PATCH',
          headers: { 'Content-Type':'application/json', 'Authorization':`Bearer ${tok}`},
          body: JSON.stringify(patch)
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error||'Failed');
        // update local
        const idx = allBookings.findIndex(b=>b.id===id);
        if (idx!==-1) allBookings[idx] = data.booking;
        const fIdx = filtered.findIndex(b=>b.id===id);
        if (fIdx!==-1) filtered[fIdx] = data.booking;
        renderStatsFromBookings();
        renderTable();
        renderCal();
        if (detailDialog && detailDialog.open) openDetail(id); // refresh
      } catch (err) { alert('Update failed: '+(err.message||String(err))); }
    }

    function renderStatsFromBookings() {
      // recompute stats locally
      const today = new Date().toLocaleDateString('en-CA', { timeZone:'Asia/Kolkata'});
      const upcoming = allBookings.filter(b=> b.date >= today && !['cancelled','completed'].includes(b.status)).length;
      const pending = allBookings.filter(b=>b.status==='pending').length;
      const confirmed = allBookings.filter(b=>b.status==='confirmed').length;
      const priceMap = { without_ice:1000, contrast_sound:1500 };
      const revenue = allBookings.filter(b=>['pending','confirmed'].includes(b.status)).reduce((s,b)=> s + (priceMap[b.service]||0)*(b.guests||1),0);
      stats = { total: allBookings.length, pending, confirmed, cancelled: allBookings.filter(b=>b.status==='cancelled').length, completed: allBookings.filter(b=>b.status==='completed').length, today: allBookings.filter(b=>b.date===today).length, upcoming, revenue_pending: revenue };
      renderStats();
    }

    // Detail dialog
    async function openDetail(id) {
      const b = allBookings.find(x=>x.id===id);
      if (!b || !detailBody || !detailDialog) return;
      const created = b.created_at ? new Date(b.created_at).toLocaleString('en-IN', { timeZone:'Asia/Kolkata', dateStyle:'full', timeStyle:'short'}) : '—';
      const updated = b.updated_at ? new Date(b.updated_at).toLocaleString('en-IN', { timeZone:'Asia/Kolkata'}) : '—';
      detailBody.innerHTML = `
        <div style="display:grid; gap:1rem;">
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center;">
            <span class="admin-pill st-${b.status.replace(' ','-')}" style="font-size:0.9rem; padding:6px 10px;">${escape(b.status)}</span>
            <span style="font-family:var(--font-mono); font-size:0.82rem; color:var(--color-ink-subtle)">${escape(b.id)} · ${escape(b.date)} ${escape(b.slot)}</span>
          </div>
          <table style="width:100%; font-size:0.92rem; border-collapse:collapse;">
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0; width:110px;">Service</td><td style="color:var(--forest-deep); font-weight:600;">${escape(b.service_label)} · ${escape(b.price_label||'')}</td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Guests</td><td style="color:var(--forest-deep); font-weight:700;">${b.guests}</td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Name</td><td>${escape(b.name)}</td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Email</td><td><a href="mailto:${escape(b.email)}">${escape(b.email)}</a></td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Phone</td><td>${b.phone ? `<a href="tel:${escape(b.phone)}">${escape(b.phone)}</a> · <a href="https://wa.me/${escape(b.phone.replace(/[^0-9]/g,''))}" target="_blank">WhatsApp</a>` : '—'}</td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Created</td><td style="font-size:0.84rem; color:var(--color-ink-muted)">${escape(created)}</td></tr>
            <tr><td style="color:var(--color-ink-subtle); padding:6px 8px 6px 0;">Updated</td><td style="font-size:0.84rem; color:var(--color-ink-muted)">${escape(updated)}</td></tr>
          </table>
          <div>
            <label style="font-size:0.86rem; font-weight:600; color:var(--forest-deep);">Notes</label>
            <p style="white-space:pre-wrap; background: var(--color-bg-muted); padding:0.75rem; border-radius:var(--radius-md); font-size:0.9rem; color:var(--color-ink-muted); min-height: 60px; border:1px solid var(--color-border);">${escape(b.notes||'—')}</p>
            <textarea id="detail-notes" rows="3" placeholder="Edit notes…" style="width:100%; margin-top:0.5rem; padding:0.6rem; border-radius:var(--radius-md); border:1px solid var(--color-border-strong); font:inherit;">${escape(b.notes||'')}</textarea>
          </div>
        </div>
      `;
      if (detailFoot) {
        detailFoot.innerHTML = `
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap; justify-content:space-between; align-items:center; width:100%;">
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <button type="button" class="admin-ghost" data-detail="save">Save notes</button>
              <button type="button" class="admin-ghost" data-detail="confirmed">Confirm</button>
              <button type="button" class="admin-ghost" data-detail="completed">Complete</button>
              <button type="button" class="admin-ghost" data-detail="cancelled">Cancel</button>
              <button type="button" class="admin-ghost" style="color:var(--color-danger); border-color:var(--color-danger)" data-detail="delete">Delete</button>
            </div>
            <button type="button" class="cta cta--ghost cta--md" onclick="this.closest('dialog').close()">Close</button>
          </div>
        `;
        detailFoot.querySelector('[data-detail="save"]')?.addEventListener('click', async () => {
          const ta = document.getElementById('detail-notes');
          const notes = ta ? ta.value : '';
          await patchBooking(id, { notes });
          alert('Notes saved');
        });
        detailFoot.querySelectorAll('[data-detail="confirmed"],[data-detail="completed"],[data-detail="cancelled"]').forEach(btn=>{
          btn.addEventListener('click', async ()=> {
            const st = btn.getAttribute('data-detail');
            if (!confirm(`Mark ${id} as ${st}?`)) return;
            await patchBooking(id, { status: st });
          });
        });
        detailFoot.querySelector('[data-detail="delete"]')?.addEventListener('click', async ()=>{
          if (!confirm(`Delete ${id}? This cannot be undone.`)) return;
          const tok = getToken();
          try {
            const res = await fetch(`/api/bookings/${encodeURIComponent(id)}`, { method:'DELETE', headers:{ 'Authorization':`Bearer ${tok}`} });
            const data = await res.json();
            if (!res.ok || !data.ok) throw new Error(data.error||'Failed');
            allBookings = allBookings.filter(x=>x.id!==id);
            filtered = filtered.filter(x=>x.id!==id);
            renderStatsFromBookings();
            renderTable();
            renderCal();
            detailDialog.close();
          } catch(e){ alert('Delete failed: '+(e.message||String(e))); }
        });
      }
      if (typeof detailDialog.showModal === 'function') detailDialog.showModal();
      else detailDialog.setAttribute('open','');
    }

    // Mini cal: next 7 days
    async function renderCal() {
      if (!calGrid) return;
      const tok = getToken();
      if (!tok) return;
      // build 7 days starting today IST
      const today = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata'}));
      const days = [];
      for (let i=0;i<7;i++) {
        const d = new Date(today); d.setDate(today.getDate()+i);
        const iso = d.toLocaleDateString('en-CA', { timeZone:'Asia/Kolkata'});
        const label = d.toLocaleDateString('en-IN', { timeZone:'Asia/Kolkata', weekday:'short', day:'numeric', month:'short'});
        days.push({ iso, label });
      }
      // fetch availability for each day (parallel)
      calGrid.innerHTML = days.map(d=> `<div class="admin-cal__day" data-date="${d.iso}"><strong>${d.label}</strong><span style="font-size:0.78rem; color:var(--color-ink-subtle)">loading…</span></div>`).join('');
      // fetch each
      await Promise.all(days.map(async (d) => {
        try {
          const res = await fetch(`/api/bookings/availability?date=${encodeURIComponent(d.iso)}`);
          const data = await res.json();
          const el = calGrid.querySelector(`[data-date="${d.iso}"]`);
          if (!el || !data.ok) return;
          const totalTaken = data.slots.reduce((s,x)=> s + x.taken,0);
          const totalCap = data.slots.length * data.capacity;
          const isFiltered = fDate ? fDate.value===d.iso : false;
          el.innerHTML = `<strong>${d.label}</strong><span class="admin-cal__sub">${d.iso}${isFiltered?' · filtered':''}</span><div class="admin-cal__slots">${data.slots.map(s=>`<span class="${s.full?'is-full': s.remaining<=2?'is-tight':''}" title="${s.label}: ${s.taken}/${s.capacity} taken">${s.slot} ${s.remaining} left</span>`).join('')}</div><span style="font-size:0.74rem; color:var(--color-ink-subtle)">${totalTaken}/${totalCap} taken total</span>`;
          el.style.cursor='pointer';
          el.style.borderColor = isFiltered ? 'var(--clay-terracotta)' : '';
          el.addEventListener('click', ()=> {
            if (fDate) fDate.value = d.iso;
            applyFilters();
            window.scrollTo({ top: document.querySelector('.admin-table-wrap')?.offsetTop - 20 || 0, behavior:'smooth'});
          });
        } catch {}
      }));
    }

    // Init
    (async () => {
      const ok = await tryAutoLogin();
      if (!ok) showLogin();
    })();
  })();
</script>

