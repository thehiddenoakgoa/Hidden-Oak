---
/**
 * Hero — full-bleed cinematic landing.
 * Brighter golden-hour treatment, dual heat + ice atmosphere,
 * logo lives in the floating nav over this image (no site header bar).
 */
import CTAButton from './CTAButton.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  video?: string;
  /** Mobile-only self-hosted video (portrait 9:16) — replaces the desktop video under 640px */
  videoMobile?: string;
  /** YouTube watch URL/ID to embed as the hero background (native player chrome) */
  youtube?: string;
  /** Mobile-only YouTube URL/ID (9:16 portrait) — replaces the desktop video under 640px */
  youtubeMobile?: string;
  /** Zoom factor applied to the YouTube embed to crop black bars, e.g. 1.2 */
  youtubeScale?: number;
  /** Zoom factor applied to the mobile YouTube embed under 640px */
  youtubeMobileScale?: number;
  poster?: string;
  image?: string;
  /** CSS object-position for the poster image, e.g. "center 70%" */
  posterPosition?: string;
  /** Black matte over the media for readability (image heroes too) */
  matte?: boolean;
  /** Matte opacity (0–1), default 0.34 */
  matteOpacity?: number;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  align?: 'left' | 'center';
  compact?: boolean;
  atmosphere?: boolean;
  /** Emphasize ice atmosphere (frost particles, cool grade) */
  ice?: boolean;
  /** Dual heat + ice particles */
  dual?: boolean;
  /** Show the drifting steam clouds over the media */
  steam?: boolean;
  /** Subtle fireflies drifting and blinking over the media */
  fireflies?: boolean;
  /** Keep the title on a single line (white-space: nowrap) */
  titleNowrap?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  video,
  youtube,
  poster,
  image,
  posterPosition,
  matte = false,
  matteOpacity = 0.34,
  primaryCta = { href: '/book', label: 'Book a Session' },
  secondaryCta,
  align = 'left',
  compact = false,
  atmosphere = true,
  ice = false,
  dual = true,
  steam = true,
  fireflies = false,
  titleNowrap = false,
  youtubeScale = 1,
  youtubeMobileScale = 1.15,
  youtubeMobile = '',
} = Astro.props;

const videoMobile = Astro.props.videoMobile;
const bgImage = poster || image;
const hasVideo = Boolean(video);
const hasYoutube = Boolean(youtube);
const youtubeId =
  (youtube || '').match(/(?:youtu\.be\/|v=|\/shorts\/|embed\/)([\w-]{11})/)?.[1] ||
  (youtube || '');
const youtubeMobileId =
  (youtubeMobile || '').match(/(?:youtu\.be\/|v=|\/shorts\/|embed\/)([\w-]{11})/)?.[1] ||
  (youtubeMobile || '');const showAtm = atmosphere && !bgImage && !hasVideo && !hasYoutube;
const showIce = ice || dual;
const showHeat = !ice || dual;
---

<section
  class:list={[
    'hero',
    `hero--${align}`,
    {
      'hero--has-video': hasVideo,
      'hero--has-image': Boolean(bgImage),
      'hero--has-youtube': hasYoutube,
      'hero--media-live': hasYoutube || hasVideo,
      'hero--youtube-mobile': Boolean(youtubeMobileId),
      'hero--compact': compact,
      'hero--atmosphere': showAtm || Boolean(bgImage),
      'hero--ice': ice && !dual,
      'hero--dual': dual,
    },
  ]}
  data-has-video={hasVideo || hasYoutube ? 'true' : 'false'}
>
  <div class="hero__media" aria-hidden="true">
    {
      showAtm && (
        <img
          class="hero__poster hero__poster--atm"
          src="/images/hero/hero-poster.jpg"
          alt=""
          role="presentation"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )
    }
    {
      bgImage && (
        <img
          class="hero__poster"
          src={bgImage}
          alt=""
          role="presentation"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style={posterPosition ? `object-position: ${posterPosition}` : undefined}
        />
      )
    }
    {
      hasYoutube && youtubeId && (
        <iframe
          class="hero__youtube"
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=1&controls=1&loop=1&playsinline=1&playlist=${youtubeId}&rel=0&enablejsapi=1`}
          title={title}
          loading="eager"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          tabindex="-1"
          data-youtube-id={youtubeId}
          data-youtube-mobile-id={youtubeMobileId || ''}
          data-current={youtubeId}
          style={
            [
              youtubeScale !== 1 ? `--youtube-scale: ${youtubeScale}` : '',
              youtubeMobileId ? `--youtube-scale-mobile: ${youtubeMobileScale}` : '',
            ]
              .filter(Boolean)
              .join(';') || undefined
          }
        ></iframe>
      )
    }
    {
      hasVideo && video && (
        <video
          class="hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster={bgImage || undefined}
          tabindex="-1"
        >
          {videoMobile && <source src={videoMobile} type="video/mp4" media="(max-width: 640px)" />}
          <source src={video} type="video/mp4" />
        </video>
      )
    }
  </div>

  <!-- Golden-hour wash: lifts midtones, keeps edges readable -->
  <div class="hero__grade" aria-hidden="true"></div>
  <div class="hero__overlay" aria-hidden="true"></div>
  {
    (hasYoutube || hasVideo || matte) && (
      <div
        class="hero__matte"
        style={matte ? `opacity: ${matteOpacity}` : undefined}
        aria-hidden="true"
      ></div>
    )
  }

  {
    showHeat && steam && (
      <div class="hero__steam" aria-hidden="true">
        <span class="hero__steam-cloud hero__steam-cloud--a"></span>
        <span class="hero__steam-cloud hero__steam-cloud--b"></span>
        <span class="hero__steam-cloud hero__steam-cloud--c"></span>
      </div>
    )
  }

  {
    showHeat && (
      <div class="ember-field" aria-hidden="true">
        {[14, 30, 48, 66, 82, 90, 38, 58].map((left, i) => (
          <span
            class="ember"
            style={`left:${left}%; bottom:${(i % 4) * 8}%; --ember-dur:${8 + (i % 5)}s; --ember-delay:${i * 1.1}s;`}
          />
        ))}
      </div>
    )
  }

  {
    showIce && (
      <div class="frost-field" aria-hidden="true">
        {[8, 22, 40, 55, 72, 85, 18, 62, 44, 78].map((left, i) => (
          <span
            class="frost"
            style={`left:${left}%; top:${(i % 5) * 12 + 8}%; --frost-dur:${10 + (i % 6)}s; --frost-delay:${i * 0.85}s; --frost-size:${3 + (i % 4)}px;`}
          />
        ))}
      </div>
    )
  }

  {
    fireflies && (
      <div class="firefly-field" aria-hidden="true">
        {[12, 28, 44, 62, 78, 88, 20, 55, 70, 36, 8, 48].map((left, i) => (
          <span
            class="firefly"
            style={`left:${left}%; top:${12 + (i % 6) * 13}%; --fly-dur:${16 + (i % 7)}s; --fly-delay:${i * 1.4}s; --blink-dur:${2.6 + (i % 5) * 0.7}s; --tx:${(i % 2 ? -1 : 1) * (4 + (i % 4) * 2)}vw; --ty:${(i % 2 ? 1 : -1) * (2 + (i % 3) * 2)}vh; --fly-size:${3 + (i % 3)}px;`}
          />
        ))}
      </div>
    )
  }

  <div class="hero__content container">
    {
      dual && !compact && (
        <div class="hero__pillars" data-reveal="fade" aria-hidden="true">
          <span class="hero__pillar hero__pillar--heat">
            <span class="deco-icon deco-icon--sm deco-icon--flame"></span>
            Fire
          </span>
          <span class="hero__pillars-dot"></span>
          <span class="hero__pillar hero__pillar--ice">
            <span class="deco-icon deco-icon--sm deco-icon--snowflake"></span>
            Ice
          </span>
        </div>
      )
    }
    {eyebrow && <p class="eyebrow hero__eyebrow" data-reveal="fade">{eyebrow}</p>}
    <h1 class:list={['hero__title', { 'hero__title--nowrap': titleNowrap }]} data-reveal style="--reveal-delay: 60ms">{title}</h1>
    {subtitle && (
      <p class="hero__subtitle" data-reveal style="--reveal-delay: 140ms">
        {subtitle}
      </p>
    )}
    <div class="hero__actions" data-reveal style="--reveal-delay: 220ms">
      <CTAButton href={primaryCta.href} variant="primary" size="lg">{primaryCta.label}</CTAButton>
      {
        secondaryCta && (
          <CTAButton href={secondaryCta.href} variant="ghost" size="lg">
            {secondaryCta.label}
          </CTAButton>
        )
      }
    </div>
  </div>

  {
    !compact && (
      <a href="#main-content" class="hero__scroll" aria-label="Scroll to content">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span class="hero__scroll-text">Explore</span>
      </a>
    )
  }

  <script is:inline>
    (function () {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hero = document.currentScript && document.currentScript.closest('.hero');
      var video = hero && hero.querySelector('video.hero__video');
      if (!video) return;
      video.addEventListener('playing', function () {
        hero.classList.add('hero--live');
      });
      video.addEventListener('loadeddata', function () {
        hero.classList.add('hero--live');
      });
      setTimeout(function () {
        hero.classList.add('hero--live');
      }, 4000);
      if (prefersReduced) {
        video.pause();
        video.removeAttribute('autoplay');
      } else {
        video.muted = true;
        video.play().catch(function () {});
      }
      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', function (e) {
        if (e.matches) {
          video.pause();
        } else {
          video.play().catch(function () {});
        }
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var hero = document.currentScript && document.currentScript.closest('.hero');
      if (!hero) return;
      var iframe = hero.querySelector('iframe.hero__youtube');
      if (!iframe) return;
      var desktopId = iframe.getAttribute('data-youtube-id');
      var mobileId = iframe.getAttribute('data-youtube-mobile-id');
      if (!desktopId || !mobileId || desktopId === mobileId) return;

      function embed(id, controls) {
        return (
          'https://www.youtube-nocookie.com/embed/' + id +
          '?autoplay=1&mute=1&controls=' + controls + '&loop=1&playsinline=1&playlist=' + id +
          '&rel=0' + (controls === '0' ? '&modestbranding=1' : '') + '&enablejsapi=1'
        );
      }

      var mq = window.matchMedia('(max-width: 640px)');
      function apply() {
        var id = mq.matches ? mobileId : desktopId;
        if (iframe.getAttribute('data-current') === id) return;
        iframe.src = embed(id, mq.matches ? '0' : '1');
        iframe.setAttribute('data-current', id);
      }
      apply();
      mq.addEventListener('change', apply);
    })();
  </script>

  <script is:inline>
    (function () {
      var hero = document.currentScript && document.currentScript.closest('.hero');
      if (!hero) return;
      var iframe = hero.querySelector('iframe.hero__youtube');
      if (!iframe) return;

      var started = false;
      function fire() {
        if (started) return;
        started = true;
        setTimeout(function () {
          hero.classList.add('hero--live');
        }, 88);
      }

      window.addEventListener('message', function (e) {
        if (e.source !== iframe.contentWindow) return;
        var d;
        try { d = JSON.parse(e.data); } catch (err) { return; }
        if (d.event === 'onStateChange' && d.info === 1) fire();
      });

      // Fallback: if playback state is never reported, release effects anyway.
      setTimeout(function () {
        if (!started) fire();
      }, 4000);
    })();
  </script>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 80% at 50% 20%, rgba(255, 176, 96, 0.22), transparent 58%),
      radial-gradient(80% 60% at 85% 90%, rgba(120, 180, 210, 0.12), transparent 50%),
      #2a1f16;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /* Room for floating nav logo over the image */
    padding-top: var(--header-height);
  }
  .hero--compact {
    min-height: clamp(380px, 56vh, 560px);
    align-items: center;
  }
  .hero--center .hero__content {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero__youtube {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    transform: scale(var(--youtube-scale, 1));
  }
  .hero--has-youtube .hero__youtube {
    pointer-events: auto;
  }
  .hero--has-video .hero__video {
    pointer-events: none;
  }
  /* Brighter — golden hour before sunset */
  .hero__poster,
  .hero__poster--atm {
    filter:
      brightness(1.18)
      contrast(1.06)
      saturate(1.18)
      sepia(0.08);
    animation: hero-ken 32s var(--ease-in-out) infinite alternate;
  }
  .hero--ice .hero__poster {
    filter:
      brightness(1.2)
      contrast(1.05)
      saturate(0.95)
      hue-rotate(8deg);
  }
  @keyframes hero-ken {
    from { transform: scale(1.02); }
    to { transform: scale(1.1); }
  }
  .hero__poster { z-index: 1; }
  .hero__video { z-index: 2; }

  /* Warm lift + subtle cool at edges for dual story */
  .hero__grade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 90% 70% at 40% 55%, rgba(255, 190, 110, 0.18), transparent 65%),
      radial-gradient(ellipse 50% 55% at 88% 70%, rgba(140, 200, 230, 0.14), transparent 60%),
      linear-gradient(180deg, rgba(255, 200, 130, 0.1) 0%, transparent 40%);
    mix-blend-mode: soft-light;
  }

  .hero__steam {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__steam-cloud {
    position: absolute;
    width: 90%;
    height: 75%;
    background-image: var(--img-steam);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    filter: blur(8px);
    opacity: 0.16;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }
  .hero__steam-cloud--a {
    top: 0;
    left: -30%;
    animation: steam-drift-a 28s var(--ease-in-out) infinite;
  }
  .hero__steam-cloud--b {
    bottom: -8%;
    right: -35%;
    width: 95%;
    opacity: 0.12;
    animation: steam-drift-b 34s var(--ease-in-out) infinite;
    animation-delay: -12s;
  }
  .hero__steam-cloud--c {
    top: 30%;
    left: 10%;
    width: 70%;
    height: 50%;
    opacity: 0.08;
    animation: steam-drift-a 40s var(--ease-in-out) infinite reverse;
    animation-delay: -6s;
  }
  @keyframes steam-drift-a {
    0%   { transform: translate(0, 0) scale(1); opacity: 0.1; }
    50%  { transform: translate(32vw, 20px) scale(1.1); opacity: 0.22; }
    100% { transform: translate(68vw, 0) scale(1); opacity: 0.1; }
  }
  @keyframes steam-drift-b {
    0%   { transform: translate(0, 0) scale(1.05); opacity: 0.06; }
    50%  { transform: translate(-30vw, -16px) scale(1.14); opacity: 0.16; }
    100% { transform: translate(-65vw, 0) scale(1.05); opacity: 0.06; }
  }

  .hero .ember-field,
  .hero .frost-field,
  .hero .firefly-field { z-index: 3; }

  .frost-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .frost {
    position: absolute;
    width: var(--frost-size, 4px);
    height: var(--frost-size, 4px);
    border-radius: 50%;
    background: radial-gradient(circle, #e8f4ff 0%, #9ec8e0 60%, transparent 100%);
    box-shadow: 0 0 8px rgba(160, 210, 240, 0.55), 0 0 16px rgba(120, 180, 220, 0.25);
    opacity: 0;
    animation: frost-drift var(--frost-dur, 11s) var(--ease-in-out) infinite;
    animation-delay: var(--frost-delay, 0s);
  }
  @keyframes frost-drift {
    0%   { transform: translateY(-10px) translateX(0) scale(0.5); opacity: 0; }
    15%  { opacity: 0.85; }
    70%  { opacity: 0.35; }
    100% { transform: translateY(55vh) translateX(-18px) scale(1.1); opacity: 0; }
  }

  .firefly-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .firefly {
    position: absolute;
    width: var(--fly-size, 4px);
    height: var(--fly-size, 4px);
    border-radius: 50%;
    background: radial-gradient(circle, #fff3c4 0%, #ffd166 40%, rgba(255, 200, 80, 0.35) 70%, transparent 100%);
    box-shadow: 0 0 6px rgba(255, 214, 102, 0.55), 0 0 14px rgba(255, 190, 70, 0.22);
    opacity: 0.15;
    will-change: transform, opacity;
    animation:
      firefly-wander var(--fly-dur, 20s) var(--ease-in-out) infinite,
      firefly-blink var(--blink-dur, 3.5s) var(--ease-in-out) infinite;
    animation-delay: var(--fly-delay, 0s);
  }
  @keyframes firefly-wander {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(calc(var(--tx, 4vw) * 0.6), calc(var(--ty, -2vh) * 0.5)); }
    50%  { transform: translate(var(--tx, 4vw), var(--ty, -2vh)); }
    75%  { transform: translate(calc(var(--tx, 4vw) * 0.4), calc(var(--ty, -2vh) * -0.4)); }
  }
  @keyframes firefly-blink {
    0%, 100% { opacity: 0.1; }
    50%  { opacity: 0.8; }
  }

  /* Lighter overlays so the photo reads as golden-hour */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(28, 20, 14, 0.28) 0%,
        rgba(28, 20, 14, 0.08) 32%,
        rgba(28, 20, 14, 0.28) 62%,
        rgba(28, 20, 14, 0.72) 100%
      ),
      radial-gradient(120% 100% at 50% 45%, transparent 40%, rgba(28, 20, 14, 0.28) 100%);
  }
  /* Black matte over the YouTube background: soft teaser dim that lifts
     text and particle effects above the moving footage. */
  .hero__matte {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: #0a0806;
    opacity: 0.34;
  }
  /* Atmosphere + reveal effects wait until the YouTube hero video starts:
     JS adds .hero--live ~0.5s after playback begins, then everything
     dissolves in. */
  .hero--media-live .hero__steam,
  .hero--media-live .ember-field,
  .hero--media-live .frost-field,
  .hero--media-live .firefly-field {
    opacity: 0;
  }
  .hero--media-live:not(.hero--live) .hero__steam-cloud,
  .hero--media-live:not(.hero--live) .ember,
  .hero--media-live:not(.hero--live) .frost,
  .hero--media-live:not(.hero--live) .firefly,
  .hero--media-live:not(.hero--live) .hero__scroll-line {
    animation-play-state: paused;
  }
  .hero--media-live.hero--live .hero__steam,
  .hero--media-live.hero--live .ember-field,
  .hero--media-live.hero--live .frost-field,
  .hero--media-live.hero--live .firefly-field,
  .hero--media-live.hero--live .hero__content [data-reveal] {
    animation: hero-dissolve 0.9s var(--ease-out) both;
  }
  .hero--media-live.hero--live .hero__content [data-reveal] {
    animation-delay: var(--reveal-delay, 0ms);
  }
  .hero--media-live.hero--live .hero__steam-cloud,
  .hero--media-live.hero--live .ember,
  .hero--media-live.hero--live .frost,
  .hero--media-live.hero--live .firefly,
  .hero--media-live.hero--live .hero__scroll-line {
    animation-play-state: running;
  }
  .hero--media-live:not(.hero--live) .hero__content [data-reveal] {
    opacity: 0;
  }
  @keyframes hero-dissolve {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }
  .hero--left .hero__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(28, 20, 14, 0.32) 0%,
        rgba(28, 20, 14, 0.06) 35%,
        rgba(28, 20, 14, 0.35) 68%,
        rgba(28, 20, 14, 0.78) 100%
      ),
      linear-gradient(95deg, rgba(28, 20, 14, 0.55) 0%, rgba(28, 20, 14, 0.22) 38%, transparent 70%);
  }
  .hero--ice .hero__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(18, 32, 42, 0.35) 0%,
        rgba(18, 32, 42, 0.1) 40%,
        rgba(18, 32, 42, 0.55) 100%
      );
  }
  /* Compact heroes: fade the bottom edge out so no dark band
     appears between the hero image and the section below it. */
  .hero--compact .hero__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(28, 20, 14, 0.36) 0%,
        rgba(28, 20, 14, 0.08) 45%,
        rgba(28, 20, 14, 0.04) 100%
      ),
      radial-gradient(120% 100% at 50% 45%, transparent 45%, rgba(28, 20, 14, 0.14) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-7) var(--space-8);
    align-items: flex-start;
    max-width: min(720px, 94vw);
  }
  .hero--compact .hero__content {
    padding-block: var(--space-6) var(--space-6);
    max-width: min(var(--container-narrow), 94vw);
  }
  .hero--media-live .hero__content {
    padding-bottom: calc(var(--space-8) + 4.5rem);
  }

  .hero__pillars {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
